<?php
include 'koneksi.php';

// === PROSES DELETE (HAPUS) ===
if (isset($_GET['action']) && $_GET['action'] == 'delete') {
    $idbarang = $_GET['id'];
    $query = "DELETE FROM barang WHERE idbarang = $idbarang";
    if (mysqli_query($conn, $query)) {
        header("Location: barang.php");
        exit();
    }
}

// === PROSES CREATE (TAMBAH) ===
if (isset($_POST['simpan'])) {
    $jenis    = $_POST['jenis'];
    $nama     = $_POST['nama'];
    $idsatuan = $_POST['idsatuan'];
    $status   = $_POST['status'];
    $harga    = $_POST['harga'];

    $query = "INSERT INTO barang (jenis, nama, idsatuan, status, harga) VALUES ('$jenis', '$nama', '$idsatuan', '$status', '$harga')";
    if (mysqli_query($conn, $query)) {
        header("Location: barang.php");
        exit();
    }
}

// === PROSES UPDATE (EDIT) ===
if (isset($_POST['update'])) {
    $idbarang = $_POST['idbarang'];
    $jenis    = $_POST['jenis'];
    $nama     = $_POST['nama'];
    $idsatuan = $_POST['idsatuan'];
    $status   = $_POST['status'];
    $harga    = $_POST['harga'];

    $query = "UPDATE barang SET jenis='$jenis', nama='$nama', idsatuan='$idsatuan', status='$status', harga='$harga' WHERE idbarang=$idbarang";
    if (mysqli_query($conn, $query)) {
        header("Location: barang.php");
        exit();
    }
}

// Ambil data untuk Edit jika tombol edit diklik
$edit_data = null;
if (isset($_GET['action']) && $_GET['action'] == 'edit') {
    $idbarang = $_GET['id'];
    $res = mysqli_query($conn, "SELECT * FROM barang WHERE idbarang = $idbarang");
    $edit_data = mysqli_fetch_assoc($res);
}

// === READ (BACA DATA) ===
$query_barang = "SELECT b.*, s.nama_satuan FROM barang b JOIN satuan s ON b.idsatuan = s.idsatuan ORDER BY b.idbarang DESC";
$result_barang = mysqli_query($conn, $query_barang);
$result_satuan = mysqli_query($conn, "SELECT * FROM satuan WHERE status = 1");
?>

